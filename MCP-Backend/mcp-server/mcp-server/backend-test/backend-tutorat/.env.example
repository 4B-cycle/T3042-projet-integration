# Copie ce fichier en ".env" (jamais commité) et adapte les valeurs.

# Port d'écoute. 8001 = valeur par défaut de BACKEND_URL dans le serveur MCP.
PORT=8001

# Jeton partagé avec le MCP : le MCP doit avoir la MÊME valeur dans BACKEND_TOKEN.
# Génère-en un avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKEND_TOKEN=change-moi-par-un-long-jeton-aleatoire

# Base PostgreSQL (valeurs de docker-compose.yml)
DATABASE_URL=postgresql://tutorat:tutorat@localhost:5432/tutorat

# Seul hôte accepté pour l'URL du calendrier Moodle
AGENDA_HOTE_AUTORISE=moodle.ephec.be

# Swagger UI sur http://localhost:8001/docs  ("false" pour la désactiver en production)
ENABLE_DOCS=true
