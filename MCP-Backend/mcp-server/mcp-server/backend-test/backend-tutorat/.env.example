# Copie ce fichier en ".env" (jamais commité) et adapte les valeurs.

# Port d'écoute. 8001 = valeur par défaut de BACKEND_URL dans le serveur MCP.
PORT=8001

# TROIS secrets DIFFÉRENTS. Génère chacun avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# 1. Jeton "étudiant" : le MCP l'envoie (avec le JWT d'Open WebUI) pour les appels faits au nom d'un étudiant.
#    Même valeur dans BACKEND_TOKEN côté MCP.
BACKEND_TOKEN=change-moi-par-un-long-jeton-aleatoire

# 2. Jeton "service" : réservé à la boucle automatique du MCP (Moodle + notifications).
#    Même valeur dans BACKEND_SERVICE_TOKEN côté MCP.
BACKEND_SERVICE_TOKEN=change-moi-par-un-autre-long-jeton

# 3. Secret qui signe l'identité des étudiants. EXACTEMENT la même valeur que
#    FORWARD_USER_INFO_HEADER_JWT_SECRET dans Open WebUI. Le MCP n'en a pas besoin.
OPENWEBUI_JWT_SECRET=change-moi-par-un-troisieme-secret

# Nom de l'en-tête du JWT (valeur par défaut d'Open WebUI, à ne changer que si tu l'as changée là-bas)
OPENWEBUI_JWT_HEADER=X-OpenWebUI-User-Jwt

# Base PostgreSQL (valeurs de docker-compose.yml)
DATABASE_URL=postgresql://tutorat:tutorat@localhost:5432/tutorat

# Seul hôte accepté pour l'URL du calendrier Moodle
AGENDA_HOTE_AUTORISE=moodle.ephec.be

# Swagger UI sur http://localhost:8001/docs  ("false" pour la désactiver en production)
ENABLE_DOCS=true
